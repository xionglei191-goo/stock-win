        "description": "按周横截面计算每个特征与未来40交易日收益的 Spearman IC，再按六年等权汇总。",
        "engine": "Python/pandas",
        "executed_at": "2026-08-12T23:00:00+08:00",
        "filters": [
          "2018-01-01 <= asof <= 2023-12-31",
          "v4_eligible = true",
          "entry_executable = true",
          "forward_return_40 is not null",
          "2024/2025/2026 excluded"
        ],
        "language": "python",
        "metric_definitions": [
          "mean_ic：每年周等权 Spearman IC 的六年算术平均。",
          "positive_years：六个开发年度中 mean yearly IC > 0 的年度数。"
        ],
        "sql": "SELECT feature, mean_ic, positive_years, minimum_ic, maximum_ic, years_observed FROM v4_feature_metrics ORDER BY mean_ic DESC",
        "tables_used": [
          "data/research/early_winner_v4/report_sources.sqlite"
        ]
      }
